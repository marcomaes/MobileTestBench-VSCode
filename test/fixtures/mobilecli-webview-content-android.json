  "data": "\u003chtml lang=\"en\"\u003e\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\"\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\"\u003e\n  \u003ctitle\u003eSample Login\u003c/title\u003e\n  \u003cstyle\u003e\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    html, body {\n      height: 100%;\n    }\n\n    body {\n      background-color: #f5f0e8;\n      color: #111111;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 24px;\n    }\n\n    .ua {\n      position: fixed;\n      bottom: 16px;\n      left: 0;\n      right: 0;\n      text-align: center;\n      font-size: 11px;\n      color: #888880;\n      padding: 0 16px;\n      word-break: break-all;\n    }\n\n    .container {\n      width: 100%;\n      max-width: 360px;\n    }\n\n    h1 {\n      font-size: 28px;\n      font-weight: 700;\n      margin-bottom: 32px;\n      letter-spacing: -0.5px;\n    }\n\n    .form-group {\n      margin-bottom: 20px;\n    }\n\n    label {\n      display: block;\n      font-size: 14px;\n      font-weight: 600;\n      margin-bottom: 8px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    input[type=\"text\"] {\n      width: 100%;\n      padding: 14px 16px;\n      font-size: 16px;\n      background-color: #ede8de;\n      color: #111111;\n      border: 2px solid #111111;\n      border-radius: 8px;\n      outline: none;\n      transition: border-color 0.15s;\n    }\n\n    input[type=\"text\"]:focus {\n      border-color: #444444;\n      background-color: #e8e2d6;\n    }\n\n    button[type=\"submit\"] {\n      width: 100%;\n      padding: 16px;\n      margin-top: 8px;\n      font-size: 16px;\n      font-weight: 700;\n      background-color: #111111;\n      color: #f5f0e8;\n      border: none;\n      border-radius: 8px;\n      cursor: pointer;\n      letter-spacing: 0.3px;\n      transition: background-color 0.15s;\n    }\n\n    button[type=\"submit\"]:active {\n      background-color: #333333;\n    }\n\n    .error {\n      margin-top: 12px;\n      font-size: 14px;\n      font-weight: 600;\n      color: #cc0000;\n      display: none;\n    }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cdiv class=\"container\"\u003e\n    \u003ch1\u003eSample Login\u003c/h1\u003e\n    \u003cform id=\"loginForm\"\u003e\n      \u003cdiv class=\"form-group\"\u003e\n        \u003clabel for=\"name\"\u003eName\u003c/label\u003e\n        \u003cinput type=\"text\" id=\"name\" name=\"name\" value=\"\" autocomplete=\"off\"\u003e\n      \u003c/div\u003e\n      \u003cbutton type=\"submit\"\u003eSubmit\u003c/button\u003e\n      \u003cdiv class=\"error\" id=\"error\"\u003ePlease enter your name, so we could say Hello\u003c/div\u003e\n    \u003c/form\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"ua\" id=\"ua\"\u003eMozilla/5.0 (Linux; Android 17; sdk_gphone16k_arm64 Build/CP31.260623.012; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/151.0.7922.199 Mobile Safari/537.36\u003c/div\u003e\n\n  \u003cscript\u003e\n    document.getElementById('ua').textContent = navigator.userAgent;\n\n    var params = new URLSearchParams(window.location.search);\n\n    if (params.has('done')) {\n      var doneName = params.get('done');\n      var heading = document.createElement('h1');\n      heading.textContent = 'Hello there, ' + doneName + '. You are still in the webview!';\n      var container = document.querySelector('.container');\n      container.innerHTML = '';\n      container.appendChild(heading);\n    } else {\n      var fromWebview = params.get('source') === 'webview';\n\n      document.getElementById('loginForm').addEventListener('submit', function(e) {\n        e.preventDefault();\n        var name = document.getElementById('name').value.trim();\n        var error = document.getElementById('error');\n\n        if (name === '') {\n          error.style.display = 'block';\n          return;\n        }\n\n        error.style.display = 'none';\n\n        if (fromWebview) {\n          window.location.href = 'playground://login-successful?name=' + encodeURIComponent(name);\n        } else {\n          window.location.href = '?done=' + encodeURIComponent(name);\n        }\n      });\n    }\n  \u003c/script\u003e\n\n\n\u003c/body\u003e\u003c/html\u003e"
}
