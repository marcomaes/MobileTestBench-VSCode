{
  "name": "mobile-test-bench",
  "displayName": "Mobile Test Bench",
  "icon": "media/icon.png",
  "description": "Mirror and control Android and iOS devices in VS Code, inspect their UI, and get ready-to-use Mobilewright, Appium and WebdriverIO locators.",
  "version": "1.0.1",
  "publisher": "marcomaes",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcomaes/MobileTestBench-VSCode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "mobile",
    "android",
    "ios",
    "appium",
    "mobilewright",
    "webdriverio",
    "inspector",
    "emulator",
    "simulator"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mobileTestBench",
          "title": "Mobile Devices",
          "icon": "media/icons/toolWindowDevice.svg"
        }
      ]
    },
    "views": {
      "mobileTestBench": [
        {
          "id": "mobileTestBench.devices",
          "name": "Devices"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mobileTestBench.devices",
        "contents": "No devices found.\n[Refresh](command:mobileTestBench.refreshDevices)\n[Setup guide](command:mobileTestBench.openSetupGuide)"
      }
    ],
    "commands": [
      {
        "command": "mobileTestBench.refreshDevices",
        "title": "Refresh Devices",
        "category": "Mobile Test Bench",
        "icon": "$(refresh)"
      },
      {
        "command": "mobileTestBench.openDevice",
        "title": "Open Device",
        "category": "Mobile Test Bench"
      },
      {
        "command": "mobileTestBench.showLocator",
        "title": "Show Locator on Device",
        "category": "Mobile Test Bench"
      },
      {
        "command": "mobileTestBench.openSetupGuide",
        "title": "Open Setup Guide",
        "category": "Mobile Test Bench"
      },
      {
        "command": "mobileTestBench.bootDevice",
        "title": "Boot Device",
        "category": "Mobile Test Bench"
      },
      {
        "command": "mobileTestBench.shutdownDevice",
        "title": "Shut Down Device",
        "category": "Mobile Test Bench"
      },
      {
        "command": "mobileTestBench.rebootDevice",
        "title": "Reboot Device",
        "category": "Mobile Test Bench"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "mobileTestBench.bootDevice",
          "when": "view == mobileTestBench.devices && viewItem == device.offline",
          "group": "power@1"
        },
        {
          "command": "mobileTestBench.shutdownDevice",
          "when": "view == mobileTestBench.devices && viewItem == device",
          "group": "power@2"
        },
        {
          "command": "mobileTestBench.rebootDevice",
          "when": "view == mobileTestBench.devices && viewItem == device",
          "group": "power@3"
        }
      ],
      "view/title": [
        {
          "command": "mobileTestBench.refreshDevices",
          "when": "view == mobileTestBench.devices",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mobileTestBench.showLocator",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "mobileTestBench.showLocator",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mobileTestBench.showLocator",
        "key": "ctrl+alt+shift+m",
        "mac": "ctrl+alt+shift+m",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Mobile Test Bench",
      "properties": {
        "mobileTestBench.adbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `adb`. Empty: look in `ANDROID_HOME`, the default SDK folder and `PATH`."
        },
        "mobileTestBench.useEmulatorGrpc": {
          "type": "boolean",
          "default": true,
          "description": "Use the emulator gRPC connection for fast frames and input on Android emulators."
        },
        "mobileTestBench.screenshotIntervalMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "description": "Interval of the screenshot fallback, in milliseconds."
        },
        "mobileTestBench.wdaUrl": {
          "type": "string",
          "default": "http://localhost:8100",
          "description": "WebDriverAgent URL, for iOS simulators when mobilecli is not installed."
        },
        "mobileTestBench.mjpegUrl": {
          "type": "string",
          "default": "http://localhost:9100",
          "description": "WebDriverAgent MJPEG stream URL."
        },
        "mobileTestBench.longPressMs": {
          "type": "number",
          "default": 700,
          "minimum": 300,
          "maximum": 3000,
          "description": "How long the mouse stays down before it counts as a long press, in milliseconds."
        },
        "mobileTestBench.elementFilter": {
          "type": "string",
          "default": "",
          "description": "Last filter text of the element inspector."
        },
        "mobileTestBench.locatorLanguage": {
          "type": "string",
          "default": "AS_SHOWN",
          "description": "Language of the Copy as action of the Locators tab."
        },
        "mobileTestBench.locatorWholeLine": {
          "type": "boolean",
          "default": false,
          "description": "Copy an Appium locator as a whole statement (driver.findElement(...)) instead of the bare locator."
        },
        "mobileTestBench.pageObjectLanguage": {
          "type": "string",
          "default": "MOBILEWRIGHT_TS",
          "enum": [
            "MOBILEWRIGHT_TS",
            "MOBILEWRIGHT_JS",
            "APPIUM_JAVA",
            "APPIUM_KOTLIN",
            "APPIUM_PYTHON",
            "APPIUM_CSHARP"
          ],
          "description": "Language of the generated page object."
        },
        "mobileTestBench.pageObjectLocatorStyle": {
          "type": "string",
          "default": "BASE_CLASS_FIELDS",
          "enum": [
            "BASE_CLASS_FIELDS",
            "GETTERS",
            "CONSTRUCTOR_FIELDS"
          ],
          "description": "Where the locators of a generated page object live."
        },
        "mobileTestBench.pageObjectBaseClass": {
          "type": "string",
          "default": "BasePage",
          "description": "Name of the base class a generated page object extends."
        },
        "mobileTestBench.pageObjectGenerateBaseClass": {
          "type": "boolean",
          "default": true,
          "description": "Also generate the base class file when it does not exist yet."
        },
        "mobileTestBench.pageObjectSortByName": {
          "type": "boolean",
          "default": false,
          "description": "Order the elements of a generated page object by name."
        },
        "mobileTestBench.contrastHints": {
          "type": "boolean",
          "default": true,
          "description": "Add colour contrast hints to the accessibility audit."
        },
        "mobileTestBench.recorderOutput": {
          "type": "string",
          "default": "MOBILEWRIGHT",
          "description": "Output flavour of the recorder."
        },
        "mobileTestBench.replayTimeoutSeconds": {
          "type": "number",
          "default": 10,
          "description": "Default wait timeout of a replay step, in seconds."
        },
        "mobileTestBench.replayDelayMs": {
          "type": "number",
          "default": 0,
          "description": "Pause between replay steps, in milliseconds."
        },
        "mobileTestBench.hideSystemApps": {
          "type": "boolean",
          "default": true,
          "description": "Hide system apps in the Apps tab."
        },
        "mobileTestBench.reconnectAutomatically": {
          "type": "boolean",
          "default": true,
          "description": "Reconnect automatically when a device drops."
        },
        "mobileTestBench.reconnectToLastDevice": {
          "type": "boolean",
          "default": false,
          "description": "Reconnect to the last used device when the workspace opens."
        },
        "mobileTestBench.showGrid": {
          "type": "boolean",
          "default": false,
          "description": "Draw a coordinate grid over the mirror."
        },
        "mobileTestBench.saveHierarchyWithScreenshot": {
          "type": "boolean",
          "default": false,
          "description": "When saving a screenshot, also save the UI hierarchy as an XML file next to the PNG."
        },
        "mobileTestBench.screenRecordingLimitSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 3600,
          "description": "Stop a screen recording by itself after this many seconds (0 = no limit)."
        },
        "mobileTestBench.filesDownloadFolder": {
          "type": "string",
          "default": "",
          "description": "Folder the Files tab last downloaded to (the next download starts there)."
        },
        "mobileTestBench.visualTolerance": {
          "type": "number",
          "default": 8,
          "description": "Colour tolerance of the visual diff."
        },
        "mobileTestBench.perfWindowSeconds": {
          "type": "number",
          "default": 60,
          "description": "Window of the performance charts, in seconds."
        },
        "mobileTestBench.perfStartRuns": {
          "type": "number",
          "default": 5,
          "description": "Runs per app start measurement in the Performance tab (1 to 10)."
        },
        "mobileTestBench.perfStartKind": {
          "type": "string",
          "default": "COLD",
          "enum": [
            "COLD",
            "WARM"
          ],
          "description": "Kind of the last app start measurement in the Performance tab."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs check",
    "sync:fixtures": "node scripts/sync.mjs fixtures",
    "package": "npm run build && vsce package",
    "vscode:prepublish": "npm run build",
    "smoke": "node scripts/webview-smoke.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "bugs": {
    "url": "https://github.com/marcomaes/MobileTestBench-VSCode/issues"
  },
  "homepage": "https://github.com/marcomaes/MobileTestBench-VSCode#readme"
}
